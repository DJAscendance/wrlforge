#VRML V2.0 utf8
# Original, permission-safe Mall-item-shaped sample (not a real mall asset).
WorldInfo {
  title "Sample Crate"
}
DEF Crate Transform {
  translation 0 0 0
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.6 0.4 0.2 }
        texture ImageTexture { url "crate.jpg" }
      }
      geometry Box { size 1 1 1 }
    }
  ]
}
