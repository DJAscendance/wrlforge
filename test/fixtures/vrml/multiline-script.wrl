#VRML V2.0 utf8
WorldInfo { title "Multiline Script" }
DEF Logic Script {
  eventIn SFTime touchTime
  eventOut SFVec3f position_changed
  url "vrmlscript:
    function touchTime(value, time) {
      position_changed = new SFVec3f(0, 1, 0);
    }
  "
}
DEF Box1 Transform {
  translation 0 0 0
  children [
    Shape {
      appearance Appearance { texture ImageTexture { url "after.png" } }
      geometry Box {}
    }
  ]
}
ROUTE Logic.position_changed TO Box1.set_translation
