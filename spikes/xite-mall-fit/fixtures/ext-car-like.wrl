#VRML V2.0 utf8
# Realistic car-like extrusion: an 8-point rounded chassis cross-section
# (roughly 3.6 wide, 1.4 tall in its own plane) swept along a vertical spine
# with a slight taper (scale 1.0 at the base narrowing to 0.85 at the top).
# Bounds are cross-checked against X_ITE's own generated mesh (oracle), not
# hand-derived, since a rounded multi-vertex profile is tedious to work by hand.
WorldInfo { title "Extrusion Car-Like Chassis" }
Shape { geometry Extrusion {
  crossSection [ -1.8 -0.4, -1.5 -0.7, 1.5 -0.7, 1.8 -0.4, 1.8 0.4, 1.2 0.7, -1.2 0.7, -1.8 0.4, -1.8 -0.4 ]
  spine [ 0 0 0, 0 1.5 0, 0 3 0 ]
  scale [ 1 1, 0.95 0.95, 0.85 0.85 ]
  beginCap TRUE
  endCap TRUE
} }
