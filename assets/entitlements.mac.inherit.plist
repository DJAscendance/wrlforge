<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Inherited entitlements for the Electron helper apps (Renderer / GPU / Plugin).

  Identical to the parent set plus com.apple.security.inherit, which is what
  makes a helper adopt the parent's sandbox/runtime posture instead of
  declaring its own. electron-builder 26 signs the helpers with this file.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
