<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements for the Developer ID signed WRL Forge app.

  Minimum viable set for an Electron application: V8 requires both JIT and the
  ability to map unsigned executable memory, and Hardened Runtime denies both by
  default. Nothing else is granted.

  Deliberately ABSENT (do not add without a measured failure proving the need):
    com.apple.security.cs.disable-library-validation
    com.apple.security.get-task-allow
    com.apple.security.app-sandbox
  WRL Forge does no networking (direct upload is a locked-out product decision),
  loads no third-party plug-ins, and needs no device or privacy permissions.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
